{
  "default_bucket": "my-data-lake",
  "default_format": "parquet",
  "endpoint": null,
  "s3_user": "your-access-key",
  "s3_password": "your-secret-key",
  "mappings": {
    "customers.csv": {
      "bucket": "my-data-lake",
      "prefix": "bronze/customers/",
      "format": "parquet"
    },
    "orders.csv": {
      "bucket": "my-data-lake",
      "prefix": "bronze/orders/",
      "format": "parquet"
    },
    "products.xlsx": {
      "bucket": "my-data-lake",
      "prefix": "bronze/products/",
      "format": "parquet"
    },
    "*.csv": {
      "bucket": "my-data-lake",
      "prefix": "bronze/misc/",
      "format": "csv"
    }
  }
}
